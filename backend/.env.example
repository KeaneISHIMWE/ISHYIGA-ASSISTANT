# Server
# Hosts such as Railway and Render set PORT for you.
PORT=4000
NODE_ENV=development

# OpenAI (GPT-5.6 Sol)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_VISION_MODEL=gpt-5.6-sol

# WhatsApp Business Cloud API (used in later phases)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Typing indicators need v23.0 or newer.
WHATSAPP_API_VERSION=v23.0

# CARE VIBE customer contract lookup (Call Tracking → Contract)
# GET {CUSTOMER_API_URL}/api/vibe-contract/by-phone?phone=0781111111
# Auth: Authorization: Bearer <CLIENTS_API_KEY>, or a session cookie after OTP login.
# Production base URL: https://ishyiga.rw/care
CUSTOMER_API_URL=
CUSTOMER_API_SESSION_COOKIE=
CLIENTS_API_KEY=
CUSTOMER_API_TIMEOUT_MS=8000

# Required to read conversations, dashboard, and chat APIs.
# Send as: Authorization: Bearer <CONVERSATIONS_API_KEY>
CONVERSATIONS_API_KEY=

# Optional path when importing WOLF support visits
# SUPPORT_EXCEL_PATH=../docs/WOLF_Admin_Clients_September_contacts_filled.xlsx
# SUPPORT_EXCEL_SHEET=WOLF_Admin_Clients_September_20

# PostgreSQL
# Hosted (Neon, Supabase, etc.) or local Docker after: docker compose up -d
DATABASE_URL=
# Local Docker example:
# DATABASE_URL=postgresql://ishyiga:ishyiga@localhost:5432/ishyiga

# CARE Ticket API — creates human-agent tickets on escalation events
# POST https://ishyiga.rw/care/api/client-portal/create-ticket
# Auth: Authorization: Bearer <CARE_TICKET_API_KEY>
CARE_TICKET_API_URL=https://ishyiga.rw/care/api/client-portal/create-ticket
CARE_TICKET_API_KEY=

# WhatsApp number used to notify the assigned support agent after a VIBE ticket is created.
# Digits only or +250... format. Do not commit the live value.
SUPPORT_NOTIFY_WHATSAPP=
