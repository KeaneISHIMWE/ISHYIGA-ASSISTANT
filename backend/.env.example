# Server
# Hosts such as Railway and Render set PORT for you.
PORT=4000
NODE_ENV=development

# OpenAI (GPT-5.6 Sol)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_VISION_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional. Default is backend/guide (PDF user guides).
# GUIDES_DIR=

# Learning resources shared when clients ask to study Ishyiga online
ISHYIGA_VIDEO_TUTORIAL_URL=
ISHYIGA_ONLINE_GUIDE_URL=

# WhatsApp Business Cloud API (used in later phases)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Typing indicators need v23.0 or newer.
WHATSAPP_API_VERSION=v23.0

# Ishyiga MySQL account database (read-only). Replaces the CARE HTTP lookup.
# Password is required. Do not commit it.
ISHYIGA_MYSQL_HOST=ishyigahigh.mysql.db
ISHYIGA_MYSQL_PORT=3306
ISHYIGA_MYSQL_DATABASE=ishyigahigh
ISHYIGA_MYSQL_USER=ishyigahigh
DB_PASSWORD=
# Set to true only if the host requires TLS.
# ISHYIGA_MYSQL_SSL=false

# Legacy CARE HTTP settings. Unused after the MySQL account lookup.
# CUSTOMER_API_URL=
# CUSTOMER_API_SESSION_COOKIE=
# CLIENTS_API_KEY=
CUSTOMER_API_TIMEOUT_MS=8000

# Required to read conversations, dashboard, and chat APIs.
# Send as: Authorization: Bearer <CONVERSATIONS_API_KEY>
CONVERSATIONS_API_KEY=

# Knowledge Studio session signing. Falls back to CONVERSATIONS_API_KEY when empty.
# The first registered studio account becomes the administrator.
STUDIO_JWT_SECRET=

# PostgreSQL
# Hosted (Neon, Supabase, etc.) or local Docker after: docker compose up -d
DATABASE_URL=
# Local Docker example:
# DATABASE_URL=postgresql://ishyiga:ishyiga@localhost:5432/ishyiga
