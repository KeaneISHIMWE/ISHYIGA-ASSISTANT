# Server
# Hosts such as Railway and Render set PORT for you.
PORT=4000
NODE_ENV=development

# Groq (Phase 6 — free API)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# WhatsApp Business Cloud API (used in later phases)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Typing indicators need v23.0 or newer.
WHATSAPP_API_VERSION=v23.0

# PostgreSQL
# Hosted (Neon, Supabase, etc.) or local Docker after: docker compose up -d
DATABASE_URL=
# Local Docker example:
# DATABASE_URL=postgresql://ishyiga:ishyiga@localhost:5432/ishyiga
